generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String?
  email        String        @unique
  password     String?
  image        String?
  role         String        @default("admin")
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id])
  employee     Employee?     @relation("UserEmployee")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Organization {
  id        String     @id @default(cuid())
  name      String
  users     User[]
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Employee {
  id                 String              @id @default(cuid())
  firstName          String
  lastName           String
  email              String
  phone              String?
  department         String?
  jobTitle           String?
  startDate          DateTime?
  status             String              @default("active")
  employmentType     String              @default("full-time")
  salary             Float?
  orgId              String
  organization       Organization        @relation(fields: [orgId], references: [id])
  timeEntries        TimeEntry[]
  leaveRequests      LeaveRequest[]
  documents          Document[]
  performanceReviews PerformanceReview[]
  payStubs           PayStub[]
  managerId          String?
  manager            Employee?           @relation("EmployeeReports", fields: [managerId], references: [id])
  reports            Employee[]          @relation("EmployeeReports")
  onboardingPlans    OnboardingPlan[]
  ptoBalance         PtoBalance?
  benefitEnrollments BenefitEnrollment[]
  userId             String?             @unique
  user               User?               @relation("UserEmployee", fields: [userId], references: [id], onDelete: SetNull)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model TimeEntry {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  orgId      String
  date       DateTime
  hours      Float
  type       String   @default("regular")
  status     String   @default("pending")
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model LeaveRequest {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  orgId      String
  type       String   @default("vacation")
  startDate  DateTime
  endDate    DateTime
  days       Float    @default(1)
  status     String   @default("pending")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Document {
  id         String    @id @default(cuid())
  name       String
  category   String    @default("other")
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  orgId      String
  fileUrl    String?
  size       String?
  uploadedAt DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model PerformanceReview {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  orgId      String
  period     String
  score      Float?
  status     String   @default("scheduled")
  notes      String?
  reviewDate DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PayrollRun {
  id            String    @id @default(cuid())
  orgId         String
  period        String
  startDate     DateTime
  endDate       DateTime
  status        String    @default("processed")
  totalGross    Float     @default(0)
  totalNet      Float     @default(0)
  employeeCount Int       @default(0)
  notes         String?
  payStubs      PayStub[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model OnboardingPlan {
  id           String          @id @default(cuid())
  orgId        String
  employeeId   String
  employee     Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  templateName String
  status       String          @default("in_progress")
  tasks        OnboardingTask[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model OnboardingTask {
  id          String         @id @default(cuid())
  planId      String
  plan        OnboardingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  title       String
  category    String         @default("general")
  order       Int            @default(0)
  completedAt DateTime?
  dueDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model PayStub {
  id             String     @id @default(cuid())
  payrollRunId   String
  payrollRun     PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  orgId          String
  grossPay       Float
  federalTax     Float      @default(0)
  stateTax       Float      @default(0)
  socialSecurity Float      @default(0)
  medicare       Float      @default(0)
  netPay         Float
  createdAt      DateTime   @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  orgId     String
  userId    String?
  type      String
  title     String
  body      String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PtoBalance {
  id           String   @id @default(cuid())
  orgId        String
  employeeId   String   @unique
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  vacationDays Float    @default(15)
  sickDays     Float    @default(10)
  personalDays Float    @default(3)
  usedVacation Float    @default(0)
  usedSick     Float    @default(0)
  usedPersonal Float    @default(0)
  year         Int      @default(2025)
  updatedAt    DateTime @updatedAt
}

model BenefitPlan {
  id          String              @id @default(cuid())
  orgId       String
  name        String
  provider    String?
  type        String              @default("health")
  description String?
  active      Boolean             @default(true)
  enrollments BenefitEnrollment[]
  createdAt   DateTime            @default(now())
}

model BenefitEnrollment {
  id         String      @id @default(cuid())
  orgId      String
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  planId     String
  plan       BenefitPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  status     String      @default("active")
  enrolledAt DateTime    @default(now())

  @@unique([employeeId, planId])
}

model ComplianceTask {
  id          String    @id @default(cuid())
  orgId       String
  title       String
  description String?
  category    String    @default("policy")
  status      String    @default("pending")
  dueDate     DateTime?
  completedAt DateTime?
  assigneeId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model InviteToken {
  id        String    @id @default(cuid())
  orgId     String
  email     String
  token     String    @unique @default(cuid())
  role      String    @default("admin")
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String
  userId     String?
  userEmail  String?
  action     String
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())
}
